[Unit]
Description=Fauux Storm live wallpaper
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/mpvpaper --auto-pause --auto-mode full --mpv-options="no-audio loop-file=inf" * /home/pc/Videos/wallpapers/storm-fauux-2560x1440.mp4
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
